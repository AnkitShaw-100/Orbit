# Production values. Vite loads this for `vite build` and ignores it for
# `vite dev`, so .env keeps pointing at the local API and this file is what
# ships — no switching a value back and forth before every commit.
#
# Vercel: Settings → Environment Variables → Import .env, and upload this file.
# Strictly it is optional there, since Vercel runs `vite build` in this
# directory and Vite reads this file on its own. Setting it in the dashboard
# too does no harm and makes the value visible where people look for it.
#
# Everything here is public by design: Vite inlines VITE_* variables into the
# bundle the browser downloads, so nothing secret can ever live in this file.

# Orbit API on Render. No trailing slash — request paths already start with
# one. The websocket URL is derived from this (https becomes wss).
VITE_API_URL=https://orbit-qfq8.onrender.com

# Supabase Auth. The publishable key identifies the project and is protected
# by row level security; it is meant to be in the browser.
VITE_SUPABASE_URL=https://pspxrddaizfvkmlpxbrj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bSWeSOewSQUf1djtDp0XHA_x6Qy_kDr
