PORT=8080
NODE_ENV=development

# Supabase pooled connection (pgbouncer, port 6543) — used by PrismaClient at runtime
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase direct connection (port 5432) — used by prisma migrate / db push
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth. The backend only verifies tokens; it never issues them.
SUPABASE_URL=https://<ref>.supabase.co
# Only for projects still on legacy HS256 JWTs. Blank = verify via JWKS.
SUPABASE_JWT_SECRET=
# Admin key, used only to delete a Supabase Auth user when someone deletes their
# Orbit account. Everything else works without it. It bypasses row-level
# security, so it belongs on the server only and never in the frontend .env.
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# Origin allowed by CORS (the Vercel production URL in production)
CLIENT_URL=http://localhost:5173
# Vercel project slug, so branch/PR preview URLs are allowed too
VERCEL_PROJECT=
# Any other allowed origins, comma separated
EXTRA_ORIGINS=
